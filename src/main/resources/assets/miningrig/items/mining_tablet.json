{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "red",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:time",
          "source": "random",
          "wobble": false,
          "entries": [
            {
              "threshold": 0,
              "model": {
                "type": "minecraft:model",
                "model": "miningrig:item/mining_tablet_dark"
              }
            },
            {
              "threshold": 0.5,
              "model": {
                "type": "minecraft:model",
                "model": "miningrig:item/mining_tablet_red"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "miningrig:item/mining_tablet_dark"
          }
        }
      },
      {
        "when": "yellow",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:time",
          "source": "random",
          "wobble": false,
          "entries": [
            {
              "threshold": 0,
              "model": {
                "type": "minecraft:model",
                "model": "miningrig:item/mining_tablet_dark"
              }
            },
            {
              "threshold": 0.5,
              "model": {
                "type": "minecraft:model",
                "model": "miningrig:item/mining_tablet_yellow"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "miningrig:item/mining_tablet_dark"
          }
        }
      },
      {
        "when": "green",
        "model": {
          "type": "minecraft:model",
          "model": "miningrig:item/mining_tablet_green"
        }
      },
      {
        "when": "dark",
        "model": {
          "type": "minecraft:model",
          "model": "miningrig:item/mining_tablet_dark"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "miningrig:item/mining_tablet_dark"
    }
  }
}
